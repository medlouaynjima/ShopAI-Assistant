# LLM provider: groq (default), google, ollama (local), or openai
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
# Optional Gemini embedding/model provider:
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.8-flash
# Optional Ollama alternative:
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434
# Optional OpenAI alternative:
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
TEMPERATURE=0.0
# Optional per-model rates in USD per 1 million tokens. Leave unset to disable estimates.
# LLM_INPUT_COST_PER_1M_USD=
# LLM_OUTPUT_COST_PER_1M_USD=

# Database: leave empty to keep using the existing SQLite database.
# For the local Compose PostgreSQL service, use
# postgresql://shopassist:<POSTGRES_PASSWORD>@localhost:5433/shopassist
DATABASE_URL=
REDIS_URL=
POSTGRES_PASSWORD=

# API
API_HOST=0.0.0.0
API_PORT=8002
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Authentication: set this to a random secret of at least 32 characters
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
AUTH_SESSION_HOURS=12

# Email verification via SMTP STARTTLS
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_USE_TLS=true

# Required for the demo admin dashboard and human return approvals
ADMIN_API_KEY=replace-with-a-long-random-secret

# Observability (optional; traces exclude messages, prompts, customer and order data)
# Langfuse: https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com (LANGFUSE_BASE_URL is also accepted)
# LangSmith: https://smith.langchain.com
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=shopassist
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
